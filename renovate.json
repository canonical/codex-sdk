{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^VERSION$/"],
      "matchStrings": [
        "(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "openai/codex",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^rust-v(?<version>.+)$"
    }
  ],
  "baseBranchPatterns": [
    "latest"
  ],
  "packageRules": [
    {
      "matchPackageNames": ["openai/codex"],
      "matchBaseBranches": ["latest"]
    }
  ]
}
