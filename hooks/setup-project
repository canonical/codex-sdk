mkdir -p "$HOME/.codex"

# Install the SDK's AGENTS.md only on first run. Once it exists — whether
# unchanged from the SDK or user-customised — refreshes leave it alone.
# To pull in an updated SDK prompt, delete the file and run `workshop refresh`.
if [[ ! -f "$HOME/.codex/AGENTS.md" ]]; then
    install -m644 "${SDK}/workshop-prompt.md" "$HOME/.codex/AGENTS.md"
fi
